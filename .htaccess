# Laravel App Root — Security Only
# (This directory is NOT web-accessible — just an extra safety net)

# Block all direct HTTP access to PHP files
<Files "*.php">
    Order allow,deny
    Deny from all
</Files>

<Files ".env">
    Order allow,deny
    Deny from all
</Files>

<Files "composer.json">
    Order allow,deny
    Deny from all
</Files>

<Files "artisan">
    Order allow,deny
    Deny from all
</Files>